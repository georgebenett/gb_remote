#!/bin/bash
# Pre-commit hook: drop macOS cruft, trim trailing whitespace, clang-format.
# Files with unstaged changes are left alone so their unstaged hunks never get
# staged by the re-add.

sed_inplace() {
    if [ "$(uname)" = Darwin ]; then sed -i '' "$@"; else sed -i "$@"; fi
}

git diff --cached --name-only --diff-filter=ACM | while IFS= read -r file; do
    case "$file" in
        .DS_Store|*/.DS_Store|._*|*/._*)
            git reset -q HEAD -- "$file"
            echo "Unstaged macOS file: $file"
            continue ;;
    esac
    [ -f "$file" ] || continue
    case "$file" in
        */ui_lite/*|*/ui_dual_throttle/*|*/managed_components/*) continue ;;
        *.bin|*.hex|*.elf|*.o|*.a|*.jpg|*.jpeg|*.png|*.gif|*.ico|*.pdf|*.zip|*.ttf|*.otf) continue ;;
    esac
    if ! git diff --quiet -- "$file"; then
        echo "Skipped (has unstaged changes): $file"
        continue
    fi

    before=$(git hash-object "$file")
    sed_inplace 's/[[:space:]]*$//' "$file"
    case "$file" in
        *.c|*.h)
            if command -v clang-format >/dev/null 2>&1; then
                clang-format -i "$file"
            else
                echo "clang-format not found (brew install clang-format)"
            fi ;;
    esac
    if [ "$before" != "$(git hash-object "$file")" ]; then
        git add -- "$file"
        echo "Formatted: $file"
    fi
done

exit 0
