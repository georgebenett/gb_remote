          "fileName": "screens.c",
          "template": "#include <string.h>\n\n#include \"screens.h\"\n#include \"images.h\"\n#include \"fonts.h\"\n#include \"actions.h\"\n#include \"vars.h\"\n#include \"styles.h\"\n#include \"ui.h\"\n\n//CUSTOM LIBRARIES: \n\n\n\n//${eez-studio LVGL_SCREENS_DEF}\n//${eez-studio LVGL_SCREENS_DEF_EXT}\n\n/*CUSTOM FUNCTIONS HERE: \nthis is responsible for loading the screens when touching the buttons\nedit this only in EEZ STUDIO*/\n\n"
