# CONFIG_TARGET_LITE is not set
CONFIG_TARGET_DUAL_THROTTLE=y
CONFIG_LCD_HOR_RES=172
CONFIG_LCD_VER_RES=320
CONFIG_LCD_OFFSET_X=34
CONFIG_LCD_OFFSET_Y=0

# Target
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

# Console (USB Serial JTAG, not UART)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# SPIRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# LVGL 9.1. The object pool is malloc'd into PSRAM (see CMakeLists.txt), so
# it can be big without costing Bluetooth internal RAM.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_MEM_SIZE_KILOBYTES=128
CONFIG_LV_USE_CLIB_STRING=y
# Frames as often as the SPI can send them; idle screens redraw nothing.
CONFIG_LV_DEF_REFR_PERIOD=15
# ESP32-S3 SIMD fills and RGB565 blends, from esp_lvgl_port.
CONFIG_LV_DRAW_SW_ASM_CUSTOM=y
CONFIG_LV_DRAW_SW_ASM_CUSTOM_INCLUDE="esp_lvgl_port_lv_blend.h"
# Display smoothness: -O2, full clock, big caches, fast PSRAM. Bluetooth
# allocates from PSRAM first, leaving internal RAM to the radio controller.
# 1 kHz ticks so the LVGL task can sleep exactly until its next timer.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_FREERTOS_HZ=1000

# Bluetooth Configuration
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# Coredump: panic handler writes an ELF core dump to the coredump partition;
# the config tool reads it back over USB (see handle_cmd_check_coredump).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
