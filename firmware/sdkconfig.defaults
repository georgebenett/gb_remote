# Common to every variant; sdkconfig.defaults.<variant> adds the rest.
# Target
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

# Console (USB Serial JTAG, not UART). It shares the port with the config
# tool's binary protocol, so INFO is for events only; DEBUG (per packet) is
# compiled out unless a debug build raises it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# SPIRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# LVGL 9.1. The object pool is malloc'd into PSRAM (see CMakeLists.txt), so
# it can be big without costing Bluetooth internal RAM.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_MEM_SIZE_KILOBYTES=128
CONFIG_LV_USE_CLIB_STRING=y
# Frames as often as the SPI can send them; idle screens redraw nothing.
CONFIG_LV_DEF_REFR_PERIOD=15
# ESP32-S3 SIMD fills and RGB565 blends, from esp_lvgl_port.
CONFIG_LV_DRAW_SW_ASM_CUSTOM=y
CONFIG_LV_DRAW_SW_ASM_CUSTOM_INCLUDE="esp_lvgl_port_lv_blend.h"
# Display smoothness: -O2, full clock, big caches, fast PSRAM. Bluetooth
# allocates from PSRAM first, leaving internal RAM to the radio controller.
# 1 kHz ticks so the LVGL task can sleep exactly until its next timer.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_FREERTOS_HZ=1000
# Dynamic frequency scaling, 80-240 MHz (app_init.c). The LVGL task holds the
# CPU at 240 while it renders. No automatic light sleep yet: measure first.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Bluetooth Configuration
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
# 5.0 alongside 4.2 only for LE Set PHY (2M during receiver updates); scan,
# advert and connect stay legacy, so the extended sub-features are off.
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_EXTEND_ADV_EN=n
CONFIG_BT_BLE_50_PERIODIC_ADV_EN=n
CONFIG_BT_BLE_50_EXTEND_SCAN_EN=n
CONFIG_BT_BLE_50_EXTEND_SYNC_EN=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# Coredump: panic handler writes an ELF core dump to the coredump partition;
# the config tool reads it back over USB (see handle_cmd_check_coredump).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
